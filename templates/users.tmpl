{{define "title"}}{{.SiteName}} — Users{{end}}
{{define "content"}}
<header class="admin-head">
  <h1>Users — {{.Ref}}</h1>
  <nav class="admin-nav">
    <a href="/auth.html">Agent console</a><a href="/account/password">Change password</a>
    <form method="POST" action="/logout" class="inline">
      <input type="hidden" name="csrf" value="{{.CSRF}}"><button class="btn ghost">Sign out</button>
    </form>
  </nav>
</header>

{{if .Error}}<div class="notice err">{{.Error}}</div>{{end}}
{{if .InviteLink}}<div class="notice ok">Invite link — copy and send it to the new user (single use, expires):<span class="code">{{.InviteLink}}</span></div>{{end}}
{{if .ResetLink}}<div class="notice ok">Password reset link — copy and send it to the user (single use, expires; reactivates the account when used):<span class="code">{{.ResetLink}}</span></div>{{end}}

<section class="card">
  <h3>Invite a user</h3>
  <form method="POST" action="/users/invite">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <div class="toolbar">
      <label>Username (optional)<input name="username" placeholder="blank = they choose"></label>
      <label>Role
        <select name="role">
          <option value="agent">Agent</option>
          <option value="admin">Admin</option>
        </select>
      </label>
      <button class="btn primary" type="submit">Create invite</button>
    </div>
  </form>
</section>

<section class="card" style="margin-top:16px">
  <h2>Chat privacy</h2>
  <p>
    Read receipts tell a visitor when an agent has actually opened their message.
    They are <strong>on by default</strong>: in live support the visitor is the one
    waiting, and knowing they have been read is information worth having.
    Turning them off hides the second tick from visitors and stops new read times
    being recorded. Delivery (“reached their device”) is always shown.
  </p>
  <form method="POST" action="/settings/read-receipts" class="inline">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <input type="hidden" name="enabled" value="{{if .ReadReceipts}}false{{else}}true{{end}}">
    <button class="btn" type="submit">
      {{if .ReadReceipts}}Turn read receipts off{{else}}Turn read receipts on{{end}}
    </button>
    <span>Currently <strong>{{if .ReadReceipts}}on{{else}}off{{end}}</strong>.</span>
  </form>
</section>

<section class="card" style="margin-top:16px">
  <table>
    <thead><tr><th>Username</th><th>Role</th><th>Status</th><th>Signed in</th><th></th></tr></thead>
    <tbody>
    {{range .Users}}
      <tr>
        <td>{{.Username}}</td>
        <td>{{.Role}}</td>
        <td>{{if .Active}}Active{{else}}Inactive{{end}}{{if .MustChangePW}} · pending first login{{end}}{{if .ResetRequested}} · <strong>reset requested</strong>{{end}}</td>
        {{/* Sessions no longer expire on their own, so this column is how a
             standing session becomes visible — and visible is what makes it
             safely revocable from the button beside it. */}}
        <td>
          {{if .Sessions}}<strong>Yes</strong>{{if gt .Sessions 1}} · {{.Sessions}} sessions{{end}}{{else}}No{{end}}
          {{if .LastLoginAt}}<br><small>last login {{loginAgo .LastLoginAt}}</small>{{end}}
        </td>
        <td>
          <form method="POST" action="/users/reset" class="inline">
            <input type="hidden" name="csrf" value="{{$.CSRF}}">
            <input type="hidden" name="user_id" value="{{.ID}}">
            <button class="btn ghost" type="submit">Reset password</button>
          </form>
          {{if .Sessions}}
          <form method="POST" action="/users/signout" class="inline">
            <input type="hidden" name="csrf" value="{{$.CSRF}}">
            <input type="hidden" name="user_id" value="{{.ID}}">
            <button class="btn ghost" type="submit">Sign out everywhere</button>
          </form>
          {{end}}
          {{if .Active}}
          <form method="POST" action="/users/deactivate" class="inline">
            <input type="hidden" name="csrf" value="{{$.CSRF}}">
            <input type="hidden" name="user_id" value="{{.ID}}">
            <button class="btn ghost" type="submit">Deactivate</button>
          </form>
          {{end}}
          <form method="POST" action="/users/delete" class="inline" onsubmit="return confirm('Permanently delete {{.Username}}? This frees the username for reuse and cannot be undone.');">
            <input type="hidden" name="csrf" value="{{$.CSRF}}">
            <input type="hidden" name="user_id" value="{{.ID}}">
            <button class="btn ghost danger" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    {{end}}
    </tbody>
  </table>
</section>
{{end}}
